rules_version = '2';

// ===============================================================
// SHARED BUCKET — READ THIS BEFORE DEPLOYING
//
// The Firebase project `crewhub-43647` is shared by DocuAlign,
// WorkGrid, and CubeSync, exactly like `firestore.rules` (see
// AGENTS.md §1 and §2a).
//
// This file is the FULL bucket ruleset, including the other apps'
// blocks, so it can be pasted into the Firebase console as-is.
// That also means it is a COPY: if WorkGrid or CubeSync change
// their Storage rules in the console, this file is stale until
// someone re-syncs it. Always diff against the console's current
// rules before pasting, and never delete a match block you do not
// recognise.
//
// It is deliberately NOT wired into `firebase.json`, so a routine
// `firebase deploy` cannot overwrite another app's rules with a
// stale copy of this file.
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        'email_verified' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function isHardcodedMaster() {
      return isVerifiedEmail() &&
        request.auth.token.email in [
          'yanguangchensp@gmail.com',
          'yanguangchen@outlook.com',
          'mushfiqsiddqiue@gmail.com',
          'desmond@rakmat.com.sg',
          'florence@rakmat.com.sg',
          'waibin@rakmat.com.sg',
          'yuxin@rakmat.com.sg',
          'shunee@rakmat.com.sg',
          'theresaongpohkuan@gmail.com',
          'theresa@rakmat.com.sg',
          'ken@rakmat.com.sg',
          'fondlekc@gmail.com',
          'account@rakmat.com.sg',
          'account1@rakmat.com.sg',
          'feichin@rakmat.com.sg',
          'taiheng@rakmat.com.sg',
          'oakkar@rakmat.com.sg',
          'agga@rakmat.com.sg',
          'ma@rakmat.com.sg',
          'khun@rakmat.com.sg',
          'yanguangchen@webwizardsg.com',
          'santofokir605@gmail.com',
          'nckeyong@gmail.com',
          'nck@rakmat.com.sg',
          'nabiullahnabin@gmail.com',
          'amirkhan3273@gmail.com',
          'pradeeprajtfw595@gmail.com',
          'saifulmal90@gmail.com',
          'diaheard2@gmail.com',
          'balki221195@gmail.com',
          'mr8890085@gmail.com',
          'naythulin731@gmail.com',
          'tasinahamedshahadat03@gmail.com',
          'parbjitsingh718@gmil.com'
        ];
    }

    function isActiveUser() {
      return isHardcodedMaster() || (isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active');
    }

    // ---------------------------------------------------------------
    // DocuAlign staff.
    //
    // This MUST mirror `isCubeSyncStaff()` in `firestore.rules` (which
    // `isDocuAlignStaff()` aliases), because a member of staff who can
    // save a report to Firestore must also be able to upload that
    // report's pictures. If the two lists disagree, the mismatch does
    // not surface as an error: the save succeeds, the upload is
    // refused per picture, and the shared report silently shows the
    // reference sample's photographs instead of its own. See
    // documentation/workbook-picture-identification.md.
    //
    // `isActiveUser()` is NOT the right predicate here, and must not be
    // substituted for this one or added alongside it:
    //   - Substituting it locks out six DocuAlign staff (including the lab
    //     engineer who signs the reports) who are on the CubeSync allowlist
    //     but absent from isHardcodedMaster and have no `users/{uid}` profile.
    //   - Adding it as an alternative grants every WorkGrid master read and
    //     write on these objects, though DocuAlign's own Firestore rules would
    //     not let them read the reports those photographs belong to. AGENTS.md
    //     §1.3 requires DocuAlign access to match verified CubeSync staff, and
    //     only this helper does.
    //
    // Keep this list in sync with firestore.rules `isCubeSyncAllowedEmail()`.
    // ---------------------------------------------------------------
    function isDocuAlignStaff() {
      return isVerifiedEmail() &&
        request.auth.token.email.lower() in [
          'yanguangchensp@gmail.com',
          'yanguangchen@outlook.com',
          'mushfiqsiddqiue@gmail.com',
          'desmond@rakmat.com.sg',
          'theresaongpohkuan@gmail.com',
          'theresa@rakmat.com.sg',
          'ken@rakmat.com.sg',
          'fondlekc@gmail.com',
          'account@rakmat.com.sg',
          'account1@rakmat.com.sg',
          'feichin@rakmat.com.sg',
          'taiheng@rakmat.com.sg',
          'oakkar@rakmat.com.sg',
          'agga@rakmat.com.sg',
          'ma@rakmat.com.sg',
          'khun@rakmat.com.sg',
          'yanguangchen@webwizardsg.com',
          'webwizardssg@gmail.com',
          'santofokir605@gmail.com',
          'nckeyong@gmail.com',
          'nck@rakmat.com.sg',
          'ernestngcy@gmail.com',
          'jlee.j.m9382@gmail.com',
          'rakdurga0000@gmail.com',
          'ilovestudy123456@gmail.com',
          'kirubhashniravendran@gmail.com'
        ];
    }

    // WorkGrid — unchanged.
    match /job-completion-signatures/{bookingId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() &&
        request.resource != null &&
        request.resource.size < 300000 &&
        request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // DocuAlign report pictures: the appendix photographs and the two
    // signature images, uploaded once when a report is saved.
    //
    // Reads are deliberately closed to staff. A public share never reads
    // through these rules: `getDownloadURL()` mints a URL carrying its own
    // unguessable access token, and that token grants the read. That is the
    // same capability-URL model the share tokens use, and it keeps the bucket
    // itself unlistable and unbrowsable. Do NOT relax this to
    // `allow read: if true` — it would not change what a recipient can see,
    // and it would expose every other app's objects to enumeration.
    match /docuAlignReportPhotos/{reportId}/{picture} {
      allow read: if isDocuAlignStaff();

      // Only images, and only the two types `pictureMediaType()` in
      // src/xlsx-reader.js can produce. Anything else the reader discards
      // before upload, so a wider pattern would only admit files this app
      // never sends -- including SVG, which can carry script.
      //
      // The bound is generous because appendix photographs come straight off a
      // phone camera; the sample workbook's are ~170KB each.
      allow write: if isDocuAlignStaff() &&
        request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg)');
    }

    // Everything else stays denied. This does NOT override the grants above:
    // Storage evaluates every matching rule and allows the request if any one
    // of them permits it. The `job-completion-signatures` block has coexisted
    // with this catch-all in production, which is the proof.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
